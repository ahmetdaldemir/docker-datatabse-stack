# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_DB=dev_db
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=dev_pass

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=dev_pass

# MongoDB
MONGO_PORT=27017
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin_pass
MONGO_DATABASE=dev_db

# Elasticsearch
ELASTICSEARCH_HTTP_PORT=9200
ELASTICSEARCH_TRANSPORT_PORT=9300
ES_JAVA_OPTS=-Xms512m -Xmx512m

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin_pass
RABBITMQ_VHOST=/

# UI Ports
REDIS_COMMANDER_PORT=8082
MONGO_EXPRESS_PORT=8083
ADMINER_PORT=8084

# Network
NETWORK_NAME=global_databases_network
